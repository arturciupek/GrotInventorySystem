@page "/reports"

@using GrotInventorySystem.Domain.Enums
@using Microsoft.EntityFrameworkCore
@using GrotInventorySystem.Data
@using GrotInventorySystem.Domain.Entities
@using GrotInventorySystem.Domain.ViewModels
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject ApplicationDbContext Db

<PageTitle>Raporty</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">
            <i class="bi bi-bar-chart-fill me-2"></i>Raporty stanu magazynu
        </h3>
        <button onclick="window.print()" class="btn btn-dark">
            <i class="bi bi-printer me-2"></i>Drukuj raport
        </button>
    </div>

    @if (ReportsList.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Brak danych do raportu.
        </div>
    }
    else
    {
        <div class="card border-0 shadow">
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Lokalizacja</th>
                            <th class="text-center">Liczba broni</th>
                            <th class="text-center">Liczba modułów</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in ReportsList)
                        {
                            <tr>
                                <td class="align-middle fw-semibold">@report.LocationName</td>
                                <td class="text-center align-middle">
                                    <span class="badge bg-dark">@report.WeaponCount</span>
                                </td>
                                <td class="text-center align-middle">
                                    <span class="badge bg-secondary">@report.ModuleCount</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@code {
    private List<ReportViewModel> ReportsList { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var locations = await Db.Locations
            .OrderBy(l => l.Name)
            .ToListAsync();

        var weapons = await Db.Weapons
            .Where(w => w.Status == WeaponStatus.Active)
            .ToListAsync();

        var modules = await Db.Modules
            .Where(m => m.Status == ModuleStatus.Active)
            .ToListAsync();

        ReportsList = locations.Select(l => new ReportViewModel
        {
            LocationName = l.Name,
            WeaponCount = weapons.Count(weapons => weapons.LocationId == l.Id),
            ModuleCount = modules.Count(modules => modules.LocationId == l.Id),  
        }).ToList();
    }

}
