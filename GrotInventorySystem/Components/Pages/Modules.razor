@page "/modules"

@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using GrotInventorySystem.Data
@using GrotInventorySystem.Domain.Entities
@using GrotInventorySystem.Domain.Enums
@using GrotInventorySystem.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject ApplicationDbContext Db
@inject EventLogService EventLogService

<PageTitle>Lista modułów</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">
            <i class="bi bi-puzzle-fill me-2"></i>Lista modułów
        </h3>
        <AuthorizeView Roles="Admin,Operator">
            <a href="/module-create" class="btn btn-dark">
                <i class="bi bi-plus-lg me-2"></i>Dodaj moduł
            </a>
        </AuthorizeView>
    </div>

    @if (ModulesList.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Brak modułów w ewidencji.
        </div>
    }
    else
    {
        <div class="card border-0 shadow">
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Zdjęcie</th>
                            <th>Nazwa</th>
                            <th>Numer seryjny</th>
                            <th>Lokalizacja</th>
                            <AuthorizeView Roles="Admin,Operator">
                                <th class="text-center">Akcje</th>
                            </AuthorizeView>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var module in ModulesList)
                        {
                            <tr>
                                <td class="align-middle">
                                    @if (!string.IsNullOrWhiteSpace(module.ImagePath))
                                    {
                                        <img src="@module.ImagePath" style="height: 50px; width: auto;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">Brak</span>
                                    }
                                </td>
                                <td class="align-middle fw-semibold">@module.Name</td>
                                <td class="align-middle">@module.SerialNumber</td>
                                <td class="align-middle">@module.Location?.Name</td>
                                <AuthorizeView Roles="Admin,Operator">
                                <td class="text-center">
                                    <a href="/module-edit/@module.Id" class="btn btn-sm btn-outline-dark me-1">
                                        <i class="bi bi-pencil me-1"></i>Edytuj
                                    </a>
                                    <AuthorizeView Roles="Admin" Context="adminAuth">
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ArchiveModule(module.Id)">
                                            <i class="bi bi-archive me-1"></i>Archiwizuj
                                        </button>
                                    </AuthorizeView>
                                </td>
                                </AuthorizeView>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@code {
    private List<Module> ModulesList { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        ModulesList = await Db.Modules
            .Include(m => m.Location)
            .Where(m => m.Status == ModuleStatus.Active)
            .OrderBy(m => m.SerialNumber)
            .ToListAsync();
    }

    private async Task ArchiveModule(Guid Id)
    {
        var module = await Db.Modules.FindAsync(Id);

        if (module == null) return;

        module.Status = ModuleStatus.Archived;

        await Db.SaveChangesAsync();
        await EventLogService.LogAsync($"Zarchwizowano moduł {module.SerialNumber}");
        await LoadDataAsync();
    }
}