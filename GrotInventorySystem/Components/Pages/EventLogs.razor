@page "/event-logs"

@using Microsoft.EntityFrameworkCore
@using GrotInventorySystem.Data
@using GrotInventorySystem.Domain.Entities
@using GrotInventorySystem.Domain.ViewModels
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject ApplicationDbContext Db

<PageTitle>Rejestr zdarzeń</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex align-items-center mb-4">
        <h3 class="fw-bold mb-0">
            <i class="bi bi-clipboard-data me-2"></i>Rejestr zdarzeń
        </h3>
    </div>

    @if (LogsList.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Brak zdarzeń.
        </div>
    }
    else
    {
        <div class="card border-0 shadow">
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Data i godzina</th>
                            <th>Akcja</th>
                            <th>Użytkownik</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in LogsList)
                        {
                            <tr>
                                <td class="align-middle">@log.Created.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="align-middle">@log.Action</td>
                                <td class="align-middle">@log.UserEmail</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@code {
    private List<EventLogViewModel> LogsList { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var logs = await Db.EventLogs
            .OrderByDescending(l => l.Created)
            .ToListAsync();

        var userIds = logs
            .Where(l => l.UserId.HasValue)
            .Select(l => l.UserId.ToString())
            .Distinct()
            .ToList();

        var users = await Db.Users
            .Where(u => userIds.Contains(u.Id))
            .ToDictionaryAsync(u => u.Id, u => u.Email);

        LogsList = logs.Select(l => new EventLogViewModel
        {
            Created = l.Created,
            Action = l.Action,
            UserEmail = l.UserId.HasValue && users.TryGetValue(l.UserId.ToString()!, out var email)
                ? email
                : "nieznany"
        }).ToList();
    }

}