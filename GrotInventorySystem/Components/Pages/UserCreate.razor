@page "/user-create"

@rendermode InteractiveServer
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager
@using Microsoft.EntityFrameworkCore
@using GrotInventorySystem.Data
@using GrotInventorySystem.Domain.Entities
@using GrotInventorySystem.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

@inject ApplicationDbContext Db
@inject EventLogService EventLogService

<PageTitle>Dodaj użytkownika</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex align-items-center mb-4">
        <h3 class="fw-bold mb-0">
            <i class="bi bi-person-plus-fill me-2"></i>Dodaj użytkownika
        </h3>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>@Message
        </div>
    }

    <div class="card border-0 shadow" style="max-width: 500px;">
        <div class="card-body p-4">

            <div class="mb-3">
                <label class="form-label fw-semibold">Email</label>
                <input @bind="Email" class="form-control" placeholder="Wpisz emial..." />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Hasło</label>
                <input type="password" @bind="Password" class="form-control" placeholder="Wpisz hasło..." />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Rola</label>
                <select @bind="SelectRole" class="form-select">
                    <option value="">-- wybierz role --</option>
                    <option value="Admin">Administrator</option>
                    <option value="Operator">Operator</option>
                    <option value="Serwis">Serwisant</option>
                    <option value="Uzytkownik">Użytkownik</option>
                </select>
            </div>

            <div class="d-flex gap-2">
                <button @onclick="SaveUser" class="btn btn-dark">
                    <i class="bi bi-save me-2"></i>Zapisz
                </button>
                <a href="/adminpanel" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Anuluj
                </a>
            </div>

        </div>
    </div>

</div>

@code {

    private List<string> UserRoles = new() { "Admin", "Operator", "Serwis", "Uzytkownik" };

    private string? Email { get; set; }
    private string? Password { get; set; }
    private string? SelectRole { get; set; }
    private string? Message { get; set; }

    private async Task SaveUser()
    {
        if (string.IsNullOrWhiteSpace(Email)) { Message = "Podaj email!"; return; }
        if (string.IsNullOrWhiteSpace(Password)) { Message = "Podaj hasło!"; return; }
        if (string.IsNullOrWhiteSpace(SelectRole)) { Message = "Wybierz rolę!"; return; }

        var user = new ApplicationUser { UserName = Email, Email = Email, EmailConfirmed = true };
        var result = await UserManager.CreateAsync(user, Password);

        if (result.Succeeded)
        {
            await UserManager.AddToRoleAsync(user, SelectRole);
            await EventLogService.LogAsync($"Dodano użytkownika {Email}");
            Message = "Użytkownik został dodany!";
        }
        else
        {
            Message = "Błąd: " + string.Join(", ", result.Errors.Select(e => e.Description));
        }
    }

}