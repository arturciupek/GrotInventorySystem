@page "/archived-weapons"

@using Microsoft.EntityFrameworkCore
@using GrotInventorySystem.Data
@using GrotInventorySystem.Domain.Entities
@using GrotInventorySystem.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

@inject ApplicationDbContext Db

<PageTitle>Archiwum broni</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex align-items-center mb-4">
        <h3 class="fw-bold mb-0">
            <i class="bi bi-archive-fill me-2"></i>Archiwum broni
        </h3>
    </div>

    @if (WeaponsList.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Brak zarchiwizowanej broni.
        </div>
    }
    else
    {
        <div class="card border-0 shadow">
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Numer seryjny</th>
                            <th>Lokalizacja</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var weapon in WeaponsList)
                        {
                            <tr>
                                <td class="align-middle fw-semibold">@weapon.SerialNumber</td>
                                <td class="align-middle">@weapon.Location.Name</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@code {
    private List<Weapon> WeaponsList { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        WeaponsList = await Db.Weapons
            .Include(w => w.Location)
            .Where(w => w.Status == WeaponStatus.Archived)
            .OrderBy(w => w.SerialNumber)
            .ToListAsync();
    }
}
