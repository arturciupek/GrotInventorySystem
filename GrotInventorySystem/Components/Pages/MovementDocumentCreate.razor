@page "/movementDocument-create"

@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using GrotInventorySystem.Data
@using GrotInventorySystem.Domain.Entities
@using GrotInventorySystem.Services
@using GrotInventorySystem.Domain.Enums
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Operator,Serwis")]

@inject ApplicationDbContext Db
@inject MovementDocumentService MovementDocumentService

<PageTitle>Wydanie / Przyjęcie</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex align-items-center mb-4">
        <h3 class="fw-bold mb-0">
            <i class="bi bi-file-earmark-plus me-2"></i>Stwórz dokument ruchu
        </h3>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>@Message
        </div>
    }

    <div class="card border-0 shadow" style="max-width: 600px;">
        <div class="card-body p-4">

            <div class="mb-3">
                <label class="form-label fw-semibold">Typ</label>
                <div class="d-flex gap-3">
                    <div class="form-check">
                        <input type="radio" class="form-check-input" @onchange='() => SelectedType = "weapon"' name="type" id="typeWeapon" />
                        <label class="form-check-label" for="typeWeapon">Broń</label>
                    </div>
                    <div class="form-check">
                        <input type="radio" class="form-check-input" @onchange='() => SelectedType = "module"' name="type" id="typeModule" />
                        <label class="form-check-label" for="typeModule">Moduł</label>
                    </div>
                </div>
            </div>

            @if (SelectedType == "weapon")
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold">Broń</label>
                    <select @bind="SelectWeaponId" class="form-select">
                        <option value="">-- wybierz broń --</option>
                        @foreach (var weapon in Weapons)
                        {
                            <option value="@weapon.Id">@weapon.SerialNumber</option>
                        }
                    </select>
                </div>
            }
            else if (SelectedType == "module")
            {
                <div class="mb-3">
                    <label class="form-label fw-semibold">Moduł</label>
                    <select @bind="SelectModuleId" class="form-select">
                        <option value="">-- wybierz moduł --</option>
                        @foreach (var module in Modules)
                        {
                            <option value="@module.Id">@module.Name</option>
                        }
                    </select>
                </div>
            }

            <div class="mb-3">
                <label class="form-label fw-semibold">Lokalizacja źródłowa</label>
                <select @bind="FromLocationId" class="form-select">
                    <option value="">-- wybierz lokalizację --</option>
                    @foreach (var location in Locations)
                    {
                        <option value="@location.Id">@location.Name</option>
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Lokalizacja docelowa</label>
                <select @bind="ToLocationId" class="form-select">
                    <option value="">-- wybierz lokalizację --</option>
                    @foreach (var location in Locations)
                    {
                        <option value="@location.Id">@location.Name</option>
                    }
                </select>
            </div>

            <div class="d-flex gap-2">
                <button @onclick="SaveDocument" class="btn btn-dark">
                    <i class="bi bi-save me-2"></i>Stwórz dokument
                </button>
                <a href="/movement-documents" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Anuluj
                </a>
            </div>

        </div>
    </div>

</div>

@code {

    private List<Location> Locations { get; set; } = new();
    private List<Weapon> Weapons { get; set; } = new();
    private List<Module> Modules { get; set; } = new();

    private string? SelectWeaponId { get; set; }
    private string? SelectModuleId { get; set; }
    private string? FromLocationId { get; set; }
    private string? ToLocationId { get; set; }
    private string? SelectedType { get; set; }
    private string? Message { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        Locations = await Db.Locations
            .OrderBy(l => l.Name)
            .ToListAsync();

        Weapons = await Db.Weapons
            .Where(w => w.Status == WeaponStatus.Active)
            .OrderBy(w => w.SerialNumber)
            .ToListAsync();

        Modules = await Db.Modules
            .Where(m => m.Status == ModuleStatus.Active)
            .OrderBy(m => m.Name)
            .ToListAsync();
            
    }

    private async Task SaveDocument()
    {
        if (string.IsNullOrWhiteSpace(FromLocationId))
        {
            Message = "Wybierz lokalizację!";
            return;
        }

        if (string.IsNullOrWhiteSpace(ToLocationId))
        {
            Message = "Wybierz lokalizację!";
            return;
        }

        Guid.TryParse(SelectWeaponId, out var weaponId);
        Guid.TryParse(SelectModuleId, out var moduleId);
        Guid.TryParse(FromLocationId, out var fromLocationId);
        Guid.TryParse(ToLocationId, out var toLocationId);

        var documentNumber = await MovementDocumentService.CreateAsync(
            weaponId == Guid.Empty ? null : weaponId,
            moduleId == Guid.Empty ? null : moduleId,
            fromLocationId,
            toLocationId);

        Message = $"Dokument {documentNumber} został utworzony!";
    }
}