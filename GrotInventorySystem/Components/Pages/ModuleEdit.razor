@page "/module-edit/{Id:guid}"

@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using GrotInventorySystem.Data
@using GrotInventorySystem.Domain.Entities
@using GrotInventorySystem.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Operator")]

@inject ApplicationDbContext Db
@inject EventLogService EventLogService

<PageTitle>Edytuj moduł</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex align-items-center mb-4">
        <h3 class="fw-bold mb-0">
            <i class="bi bi-puzzle-fill me-2"></i>Edytuj moduł
        </h3>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>@Message
        </div>
    }

    <div class="card border-0 shadow" style="max-width: 500px;">
        <div class="card-body p-4">

            <div class="mb-3">
                <label class="form-label fw-semibold">Nazwa</label>
                <input @bind="Name" class="form-control" placeholder="Wpisz nazwę modułu..." />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Numer seryjny</label>
                <input @bind="SerialNumber" class="form-control" placeholder="Wpisz numer seryjny..." />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Lokalizacja</label>
                <select @bind="SelectLocationId" class="form-select">
                    <option value="">-- wybierz lokalizację --</option>
                    @foreach (var location in Locations)
                    {
                        <option value="@location.Id">@location.Name</option>
                    }
                </select>
            </div>

            <div class="d-flex gap-2">
                <button @onclick="EditModule" class="btn btn-dark">
                    <i class="bi bi-save me-2"></i>Zapisz
                </button>
                <a href="/modules" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Anuluj
                </a>
            </div>

        </div>
    </div>

</div>

@code {

    [Parameter]
    public Guid Id { get; set; }

    private List<Location> Locations { get; set; } = new();
    private string? Name { get; set; }
    private string? SerialNumber { get; set; }
    private string? SelectLocationId { get; set; }
    private string? Message { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        Locations = await Db.Locations
            .OrderBy(l => l.Name)
            .ToListAsync();

        var module = await Db.Modules.FindAsync(Id);
        if (module != null)
        {
            Name = module.Name;
            SerialNumber = module.SerialNumber;
            SelectLocationId = module.LocationId.ToString();
        }
    }

    private async Task EditModule()
    {
        if (string.IsNullOrWhiteSpace(Name))
        {
            Message = "Podaj nazwę!";
            return;
        }

        if (string.IsNullOrWhiteSpace(SerialNumber))
        {
            Message = "Podaj numer seryjny!";
            return;
        }

        if (string.IsNullOrWhiteSpace(SelectLocationId))
        {
            Message = "Wybierz lokalizację!";
            return;
        }

        Guid.TryParse(SelectLocationId, out var locationId);

        var module = await Db.Modules.FindAsync(Id);
        if (module == null)
        {
            Message = "Nie znaleziono modułu!";
            return;
        }

        module.Name = Name!;
        module.SerialNumber = SerialNumber!;
        module.LocationId = locationId;

        await Db.SaveChangesAsync();
        await EventLogService.LogAsync($"Edytowano moduł {SerialNumber}");
        Message = "Moduł został edytowany!";
    }

}