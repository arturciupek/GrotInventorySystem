@page "/module-edit/{Id:guid}"

@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using GrotInventorySystem.Data
@using GrotInventorySystem.Domain.Entities
@using GrotInventorySystem.Services
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin,Operator")]

@inject ApplicationDbContext Db
@inject EventLogService EventLogService

<PageTitle>Edytuj moduł</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex align-items-center mb-4">
        <h3 class="fw-bold mb-0">
            <i class="bi bi-puzzle-fill me-2"></i>Edytuj moduł
        </h3>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>@Message
        </div>
    }

    <div class="card border-0 shadow" style="max-width: 500px;">
        <div class="card-body p-4">

            <div class="mb-3">
                <label class="form-label fw-semibold">Nazwa</label>
                <input @bind="Name" class="form-control" placeholder="Wpisz nazwę modułu..." />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Numer seryjny</label>
                <input @bind="SerialNumber" class="form-control" placeholder="Wpisz numer seryjny..." />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Typ modułu</label>
                <div class="row g-2">
                    @foreach (var moduleType in ModuleTypes)
                    {
                        <div class="col-4">
                            <div class="card @(SelectedImagePath == moduleType.ImagePath ? "border-dark border-2" : "border") text-center p-2"
                                 style="cursor: pointer;"
                                 @onclick="() => SelectModuleType(moduleType)">
                                <img src="@moduleType.ImagePath" style="height: 60px; object-fit: contain;" />
                                <small class="mt-1">@moduleType.Name</small>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex gap-2">
                <button @onclick="EditModule" class="btn btn-dark">
                    <i class="bi bi-save me-2"></i>Zapisz
                </button>
                <a href="/modules" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Anuluj
                </a>
            </div>

        </div>
    </div>

</div>

@code {

    [Parameter]
    public Guid Id { get; set; }

    private string? Name { get; set; }
    private string? SerialNumber { get; set; }
    private string? Message { get; set; }
    private string? SelectedImagePath { get; set; }
    private record ModuleType(string Name, string ImagePath);

    private List<ModuleType> ModuleTypes = new()
{
    new("Adapter kolby AR", "/images/modules/adapter-kolby.png"),
    new("Chwyt pistoletowy", "/images/modules/chwyt-pistoletowy.png"),
    new("Chwyt przedni", "/images/modules/chwyt-przedni.png"),
    new("Łoże", "/images/modules/loze.png"),
    new("Lufa 14.5\"", "/images/modules/lufa-14.png"),
    new("Nóż-bagnet", "/images/modules/noz-bagnet.png"),
    new("Przeziernik", "/images/modules/przeziernik.png"),
    new("Szyna Picatinny", "/images/modules/szyna-picatinny.png"),
    new("Zestaw konwersyjny 7.62", "/images/modules/zestaw-konwersyjny762.png"),
    new("Zestaw konwersyjny S10", "/images/modules/zestaws10.png"),
    new("Zestaw konwersyjny S16", "/images/modules/zestaws16.png"),
};

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var module = await Db.Modules.FindAsync(Id);
        if (module != null)
        {
            Name = module.Name;
            SerialNumber = module.SerialNumber;
            SelectedImagePath = module.ImagePath;
        }
    }

    private async Task EditModule()
    {
        if (string.IsNullOrWhiteSpace(Name))
        {
            Message = "Podaj nazwę!";
            return;
        }

        if (string.IsNullOrWhiteSpace(SerialNumber))
        {
            Message = "Podaj numer seryjny!";
            return;
        }

        var module = await Db.Modules.FindAsync(Id);
        if (module == null)
        {
            Message = "Nie znaleziono modułu!";
            return;
        }

        module.Name = Name!;
        module.SerialNumber = SerialNumber!;
        module.ImagePath = SelectedImagePath;

        await Db.SaveChangesAsync();
        await EventLogService.LogAsync($"Edytowano moduł {SerialNumber}");
        Message = "Moduł został edytowany!";
    }

    private void SelectModuleType(ModuleType moduleType)
    {
        Name = moduleType.Name;
        SelectedImagePath = moduleType.ImagePath;
    }

}