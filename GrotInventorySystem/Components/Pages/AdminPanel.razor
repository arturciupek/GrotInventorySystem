@page "/adminpanel"
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using GrotInventorySystem.Data
@using GrotInventorySystem.Domain.Entities
@using GrotInventorySystem.Domain.Enums
@using GrotInventorySystem.Services
@inject ApplicationDbContext Db
@inject EventLogService EventLogService
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUser> UserManager

<PageTitle>Lista użytkowników</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">
            <i class="bi bi-people-fill me-2"></i>Lista użytkowników
        </h3>
            <a href="/user-create" class="btn btn-dark">
                <i class="bi bi-plus-lg me-2"></i>Dodaj użytkownika
            </a>
    </div>

    @if (PersonList.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Brak użytkowników.
        </div>
    }
    else
    {
        <div class="card border-0 shadow">
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Email</th>
                            <th>Rola</th>
                                <th class="text-center">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var person in PersonList)
                        {
                            <tr>
                                <td class="align-middle fw-semibold">@person.Email</td>
                                <td class="align-middle">@person.Role</td>
                                    <td class="text-center">
                                        <a href="/person-edit/@person.Id" class="btn btn-sm btn-outline-dark me-1">
                                            <i class="bi bi-pencil me-1"></i>Zmień rolę
                                        </a>
                                    </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@code {

    private class Person
    {
        public string Id { get; set; } = default!;
        public string Email { get; set; } = default!;
        public string Role { get; set; } = default!;
    }

    private List<Person> PersonList { get; set; } = new();
    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }
    private async Task LoadDataAsync()
    {
        var users = await UserManager.Users.OrderBy(u => u.Email).ToListAsync();
        foreach (var user in users)
        {
            var roles = await UserManager.GetRolesAsync(user);
            PersonList.Add(new Person            {
                Id = user.Id,
                Email = user.Email!,
                Role = (roles.FirstOrDefault() ?? "Brak roli") switch
                {
                    "Admin" => "Administrator",
                    "Operator" => "Operator",
                    "Serwis" => "Serwisant",
                    "Uzytkownik" => "Użytkownik",
                    _ => "Brak roli"
                }
            });
        }
    }
}