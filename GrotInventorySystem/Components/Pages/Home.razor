@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.EntityFrameworkCore
@using GrotInventorySystem.Data
@using GrotInventorySystem.Domain.Enums
@attribute [Authorize]
@inject ApplicationDbContext Db

<PageTitle>GROT — Panel Główny</PageTitle>

<div class="container-fluid py-4">

    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-dark text-white border-0 shadow">
                <div class="card-body py-4 px-4">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-shield-fill" style="font-size: 3rem;"></i>
                        <div>
                            <h1 class="mb-1 fw-bold">System Ewidencji Broni</h1>
                            <p class="mb-0 text-secondary">
                                System zarządzania bronią i modułami
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow h-100 text-white" style="background-color: #2d3a1e;">
                <div class="card-body py-4 px-4">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-bullseye" style="font-size: 2.5rem;"></i>
                        <div>
                            <p class="mb-0 text-uppercase fw-bold" style="font-size: 0.8rem;">Aktywna broń</p>
                            <h2 class="mb-0 fw-bold">@WeaponCount</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow h-100 text-white" style="background-color: #1a3a2a;">
                <div class="card-body py-4 px-4">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-house-fill" style="font-size: 2.5rem;"></i>
                        <div>
                            <p class="mb-0 text-uppercase fw-bold" style="font-size: 0.8rem;">W magazynie</p>
                            <h2 class="mb-0 fw-bold">@WeaponInStorageCount</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow h-100 text-white" style="background-color: #1a2a3a;">
                <div class="card-body py-4 px-4">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-arrow-up-right-circle" style="font-size: 2.5rem;"></i>
                        <div>
                            <p class="mb-0 text-uppercase fw-bold" style="font-size: 0.8rem;">Poza magazynem</p>
                            <h2 class="mb-0 fw-bold">@WeaponOutsideCount</h2>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-8">
            <div class="card border-0 shadow h-100">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Ostatnie zdarzenia</h5>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <tbody>
                            @foreach (var log in RecentLogs)
                            {
                                <tr>
                                    <td class="align-middle text-muted" style="width: 180px;">
                                        @log.Created.ToString("dd.MM.yyyy HH:mm")
                                    </td>
                                    <td class="align-middle">@log.Action</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow h-100">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0"><i class="bi bi-lightning-fill me-2"></i>Szybkie akcje</h5>
                </div>
                <div class="card-body d-flex flex-column gap-2">
                    <a href="/weapons" class="btn btn-dark">
                        <i class="bi bi-bullseye me-2"></i>Lista broni
                    </a>
                    <a href="/modules" class="btn btn-dark">
                        <i class="bi bi-puzzle-fill me-2"></i>Lista modułów
                    </a>
                    <a href="/movementDocument-create" class="btn btn-dark">
                        <i class="bi bi-file-earmark-plus me-2"></i>Nowy dokument
                    </a>
                    <a href="/reports" class="btn btn-outline-dark">
                        <i class="bi bi-bar-chart me-2"></i>Raporty
                    </a>
                </div>
            </div>
        </div>
    </div>

</div>

@code {
    private int WeaponCount { get; set; }
    private int WeaponInStorageCount { get; set; }
    private int WeaponOutsideCount { get; set; }
    private List<GrotInventorySystem.Domain.Entities.EventLog> RecentLogs { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        WeaponCount = await Db.Weapons
            .Where(w => w.Status == WeaponStatus.Active)
            .CountAsync();

        var mainStorage = await Db.Locations
            .FirstOrDefaultAsync(l => l.Name == "Magazyn główny");

        WeaponInStorageCount = mainStorage != null
            ? await Db.Weapons
                .Where(w => w.Status == WeaponStatus.Active && w.LocationId == mainStorage.Id)
                .CountAsync()
            : 0;

        WeaponOutsideCount = WeaponCount - WeaponInStorageCount;

        RecentLogs = await Db.EventLogs
            .OrderByDescending(l => l.Created)
            .Take(5)
            .ToListAsync();
    }
}