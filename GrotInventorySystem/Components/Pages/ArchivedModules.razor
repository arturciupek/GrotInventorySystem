@page "/archived-modules"

@using Microsoft.EntityFrameworkCore
@using GrotInventorySystem.Data
@using GrotInventorySystem.Domain.Entities
@using GrotInventorySystem.Domain.Enums

@inject ApplicationDbContext Db

<PageTitle>Archiwum modułów</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex align-items-center mb-4">
        <h3 class="fw-bold mb-0">
            <i class="bi bi-archive-fill me-2"></i>Archiwum modułów
        </h3>
    </div>

    @if (ModulesList.Count == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Brak zarchiwizowanych modułów.
        </div>
    }
    else
    {
        <div class="card border-0 shadow">
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Numer seryjny</th>
                            <th>Lokalizacja</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var module in ModulesList)
                        {
                            <tr>
                                <td class="align-middle fw-semibold">@module.SerialNumber</td>
                                <td class="align-middle">@module.Location.Name</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

</div>

@code {
    private List<Module> ModulesList { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        ModulesList = await Db.Modules
            .Include(m => m.Location)
            .Where(m => m.Status == ModuleStatus.Archived)
            .OrderBy(m => m.SerialNumber)
            .ToListAsync();
    }
}
